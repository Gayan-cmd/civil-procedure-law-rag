# Copy to .env and adjust for your machine. All values here are optional --
# cpa.config falls back to sensible defaults if a variable is unset.

# CPA_CORPUS_MANIFEST=corpus/manifest.json
# CPA_CORPUS_ROOT=.

# Postgres + pgvector, run locally via:
#   docker run -d --name cpa-postgres -e POSTGRES_USER=cpa \
#     -e POSTGRES_PASSWORD=cpa_local_dev -e POSTGRES_DB=cpa \
#     -p 5432:5432 -v cpa_pgdata:/var/lib/postgresql/data pgvector/pgvector:pg16
# Use 127.0.0.1, not localhost -- see config.py's comment on why.
# CPA_DATABASE_URL=postgresql://cpa:cpa_local_dev@127.0.0.1:5432/cpa

# A separate database the test suite writes to (tests truncate/rebuild
# tables -- pointing them at CPA_DATABASE_URL would wipe real ingested
# data every time pytest runs). Created once with:
#   docker exec cpa-postgres psql -U cpa -d cpa -c "CREATE DATABASE cpa_test OWNER cpa;"
# CPA_TEST_DATABASE_URL=postgresql://cpa:cpa_local_dev@127.0.0.1:5432/cpa_test

# Schema for users/conversations/messages/citations is managed by Alembic,
# not cpa.config -- apply it with:
#   alembic upgrade head
# (reads CPA_DATABASE_URL above; see alembic/env.py)

# Signs/verifies JWTs (api/security.py) -- a long random string, NOT this
# literal value in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# CPA_JWT_SECRET_KEY=

# CPA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CPA_LLM_MODEL=openai/gpt-oss-20b

# CPA_CHUNK_SIZE=800
# CPA_CHUNK_OVERLAP=100
# CPA_RETRIEVAL_K=5

# Required for generation.py -- get a free key at console.groq.com
# GROQ_API_KEY=
